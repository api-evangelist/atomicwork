            "method": "GET",
            "url": "https://{tenant}.atomicwork.com/api/v1/assets/attributes",
            "headers": [
              {
                "name": "X-Api-Key",
                "value": ""
              },
              {
                "name": "X-Workspace-Id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "search_key",
                "value": "",
                "type": "query",
                "description": "Search String"
              },
              {
                "name": "asset_type",
                "value": "",
                "type": "query",
                "description": "asset_type"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "limit"
              },
              {
                "name": "page_size",
                "value": "",
